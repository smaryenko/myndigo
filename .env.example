# Supabase — get these from Project Settings → API in your Supabase dashboard
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Translation provider: deepl | google | libre
TRANSLATION_PROVIDER=deepl

# DeepL API key (if using DeepL) — https://www.deepl.com/pro-api
DEEPL_API_KEY=your-deepl-api-key-here

# Google Translate API key (if using Google) — https://console.cloud.google.com
GOOGLE_TRANSLATE_API_KEY=your-google-api-key-here

# LibreTranslate endpoint (if self-hosting)
LIBRE_TRANSLATE_URL=http://localhost:5000

# Email notifications (optional — for share view alerts to parents)
# Sign up at https://resend.com — free tier: 3000 emails/month
RESEND_API_KEY=your-resend-api-key
NOTIFICATION_EMAIL_FROM=notifications@yourdomain.com
